rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Progreso del jugador: cada usuario SOLO puede leer/escribir su propio documento.
    match /players/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Preparado para rankings online a futuro: cualquiera puede LEER el leaderboard
    // (para mostrar una tabla de posiciones pública), pero cada usuario solo puede
    // escribir su propia entrada.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
