rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // El progreso solo puede leerse por su propietario.
    // Toda escritura pasa por Cloud Functions, que valida y limita solicitudes.
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // El ranking es público de lectura; solo el servidor puede escribirlo.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }
  }
}
