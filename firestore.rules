rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // El cliente puede leer su propio progreso, pero NO escribirlo directamente.
    // Las escrituras pasan por syncProgress/clearProgress (Cloud Functions),
    // que valida los campos antes de persistirlos usando Admin SDK.
    match /players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // El ranking es público de lectura. Solo Cloud Functions puede actualizarlo.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }
  }
}
